# ClubHub - Django Reports Module Environment Variables
# Copy this file to .env and adjust values if needed.

# Security
SECRET_KEY=clubhub-reports-insecure-dev-secret-key-phase10-2026
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Read-Only MySQL Database Connection
# Connects to the same MySQL database instance as the PHP application.
DB_ENGINE=django.db.backends.mysql
DB_NAME=clubhub
DB_USER=clubhub_reader
DB_PASSWORD=reader123
DB_HOST=localhost
DB_PORT=3306

